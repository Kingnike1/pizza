/* Animações */
@keyframes fadeIn {
    0% { opacity: 0; }
    100% { opacity: 1; }
}

@keyframes progressAnimation {
    from { width: 0%; }
    to { width: 100%; }
}

/* Estilo geral */
body {
    font-family: 'Comic Sans MS', cursive, sans-serif;
    text-align: center;
    background: linear-gradient(135deg, #ffcc00, #ff5733); /* Gradiente amarelo e vermelho (cores da pizza) */
    color: white;
    margin: 0;
    padding: 0;
}

/* Container principal */
.container {
    margin: 30px auto;
    padding: 20px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 15px;
    max-width: 500px;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
    display: flex;
    flex-direction: column;
    align-items: center;
    animation: fadeIn 2s ease-in-out;
}

/* Estilo dos botões */
button {
    padding: 10px 15px;
    margin: 10px 5px;
    font-size: 16px;
    background: #d35400; /* Cor de massa de pizza */
    color: white;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    transition: 0.3s;
    animation: fadeIn 2s ease-in-out;
}

button:hover {
    background: #a04000;
    transform: scale(1.1);
}

/* Contador */
.counter {
    font-size: 24px;
    margin: 20px 0;
    animation: fadeIn 2s ease-in-out;
}

/* Estilo dos jogadores */
.player {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(255, 165, 0, 0.2); /* Cor laranja que lembra queijo derretido */
    padding: 10px;
    margin: 10px 0;
    border-radius: 10px;
    color: white;
    animation: fadeIn 2s ease-in-out;
}

/* Barra de progresso */
.progress-bar-container {
    background: rgba(255, 255, 255, 0.2);
    border-radius: 5px;
    height: 20px;
    margin: 10px 0;
    position: relative;
    overflow: hidden;
}

.progress-bar {
    background: #ffcc00; /* Cor de queijo */
    height: 100%;
    width: 0;
    transition: width 0.3s ease-out;
    animation: progressAnimation 2s forwards;
    border-radius: 5px;
}

/* Estilo do líder */
.leader {
    font-size: 20px;
    margin: 20px 0;
    font-weight: bold;
    color: #fff;
    animation: fadeIn 2s ease-in-out;
}

/* Estilo para o select */
#iniciarJogador {
    padding: 10px;
    font-size: 16px;
    background: #ff5733; /* Vermelho tomate */
    color: white;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    width: 100%;
    max-width: 300px;
    margin: 10px 0;
    transition: background 0.3s ease;
}

#iniciarJogador:hover {
    background: #c70039;
}

/* Estilos do Modal de Avatar */
#avatarModal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.7);
    color: white;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    z-index: 100;
    padding: 20px;
    font-family: Arial, sans-serif;
    animation: fadeIn 0.5s ease-out;
}

#avatarModal h2 {
    font-size: 24px;
    margin-bottom: 20px;
    color: #ffcc00;
}

.avatar-option {
    display: flex;
    justify-content: center;
    align-items: center;
    background: rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    padding: 10px;
    cursor: pointer;
    transition: transform 0.3s ease, background-color 0.3s ease;
}

.avatar-option:hover {
    background-color: #ff5733;
    transform: scale(1.1);
}

/* Media Queries para Responsividade */
@media (max-width: 768px) {
    .container { width: 90%; padding: 15px; }
    button { font-size: 14px; padding: 8px 12px; }
    .counter { font-size: 20px; }
}

@media (max-width: 480px) {
    .container { width: 100%; padding: 10px; }
    button { font-size: 12px; padding: 6px 10px; }
    .counter { font-size: 18px; }
}









